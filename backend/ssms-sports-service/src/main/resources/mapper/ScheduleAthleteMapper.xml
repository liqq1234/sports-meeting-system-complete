<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sports.sports.mapper.ScheduleAthleteMapper">

    <select id="selectByScheduleId" resultType="com.sports.sports.entity.ScheduleAthlete">
        SELECT sa.*
        FROM t_schedule_athlete sa
        WHERE sa.schedule_id = #{scheduleId}
        ORDER BY sa.lane_no ASC
    </select>

</mapper>
